POSTGRES_DB=challenge
POSTGRES_USER=challenge
POSTGRES_PASSWORD=challenge
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
ADMINER_PORT=8080

# Use this from containers in the Compose network.
DATABASE_URL_DOCKER=postgres://challenge:challenge@postgres:5432/challenge?sslmode=disable

# Use this from tools running on the host.
DATABASE_URL_HOST=postgres://challenge:challenge@localhost:5432/challenge?sslmode=disable

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
